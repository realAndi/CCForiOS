#!/var/jb/usr/bin/zsh
# Claude Code, native darwin-arm64 build patched to run on iOS.
# See ~/ccnative/LOG.md on the build host for how the binary was made.

export HOME="${HOME:-/var/jb/var/mobile}"

PREFIX=/var/jb
LIB=$PREFIX/usr/local/lib/claude-native

# Claude Code also writes ~/.claude.json, session transcripts and logs. Without
# this they land with default perms; the credential file is already 0600, keep
# the rest of what it records out of group/other as well.
umask 077

# The stand-ins for the two macOS tools Claude Code shells out to by name and
# iOS does not have: `security` (its keychain backend) and `open` (every URL it
# offers to open). PATH, because that is how it looks for them. See security.c
# and open.c.
export PATH="$LIB/bin:$PATH"

# --- sign-in ------------------------------------------------------------
#
# Two ways in, and whoever holds the credential handles it.
#
# Native: with bin/security working, `claude auth login` stores what it gets and
# refreshes it in place, exactly as on a Mac. The postinst probes the keychain
# through that stand-in at install time and leaves a marker, so a device where
# it does not work never silently loses a sign-in.
#
# claude-login: the OAuth flow this package has always shipped, whose master
# lives in its own keychain item. While that master exists it owns the
# credential -- publishing it into Claude Code's item before every launch -- so
# the native commands are redirected to it and /login and /logout hidden;
# a native login on top would fight it for the rotating refresh token.
#
# `setup-token` is left alone either way: it prints a token rather than storing
# one, so it works.
NATIVE_LOGIN=0
if [ -e "$LIB/native-login-ok" ] && [ ! -e "$HOME/.claude/ccauth.json" ]; then
    NATIVE_LOGIN=1
fi

if [ "$NATIVE_LOGIN" -ne 1 ]; then
    if [ "$1" = "auth" ] && [ "$2" = "login" ]; then
        shift 2
        print -u2 -- "claude: this install signs in with claude-login -- running it"
        exec $PREFIX/usr/local/bin/claude-login "$@"
    fi
    # Logout is redirected even when the native path works: it has to remove
    # claude-login's master too, or the next launch publishes it straight back.
    if [ "$1" = "auth" ] && [ "$2" = "logout" ]; then
        exec $PREFIX/usr/local/bin/claude-login --logout
    fi
    export DISABLE_LOGIN_COMMAND=1
    export DISABLE_LOGOUT_COMMAND=1
fi

# Upstream ships no iOS build, and these would fetch a macOS one over this
# install. APT owns this package.
case "$1" in
    update|upgrade|install|--update|--upgrade)
        print -u2 -- "claude: this build is installed by APT, not by Claude Code's updater."
        print -u2 -- "  Upgrade it in Sileo, or: sudo apt install --only-upgrade com.andi.claude-code-native"
        exit 1 ;;
esac

# No iOS build exists upstream, so never let it replace itself. This also
# silences every "update available" and "auto-update failed" notice, which are
# all gated on it. Not DISABLE_UPDATES or CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:
# the first prints "updates are disabled by your administrator", and the second
# turns off feature-flag evaluation, which takes Remote Control with it.
export DISABLE_AUTOUPDATER=1

# The Bash tool runs commands through CLAUDE_CODE_SHELL, else $SHELL when that
# names a bash or zsh it can execute, else /bin/bash -- which a rootless
# jailbreak does not have. zsh is a dependency of this package; bash is not, so
# it is only used when something else has installed it.
if [ -z "$CLAUDE_CODE_SHELL" ]; then
    for _sh in $PREFIX/usr/bin/bash $PREFIX/usr/bin/zsh; do
        if [ -x "$_sh" ]; then export CLAUDE_CODE_SHELL="$_sh"; break; fi
    done
    unset _sh
fi

# Conservative, no longer load-bearing. The shim used to flip the whole JIT
# pool between RW and RX for the process, and a background compiler thread doing
# that under the main thread was "panic: Bus error". It now repairs page faults
# one page at a time, which handles any number of writing threads: workers pass
# with this on and off. Kept off until a long interactive session has run with
# concurrent compilation, which writes far more often than a worker.
export BUN_JSC_useConcurrentJIT=0

# Credentials -- the claude-login half.
#
# Only does anything when claude-login holds a master (see sign-in above).
# claude-login runs the OAuth flow itself and keeps that master in its own
# keychain item, via ccauth-keychain; CCAUTH_PLAINTEXT=1 opts for a 0600 file
# instead, which is what a device with no usable keychain falls back to. This
# refreshes the access token before it expires and republishes it -- into
# ~/.claude/.credentials.json and into Claude Code's own keychain item, which it
# reads first. Both copies carry the access token only: the long-lived refresh
# token stays in the master, so nothing else can rotate it out from under us.
# Claude Code deletes .credentials.json once it has migrated it, which is why
# this runs before every launch.
#
# Deliberately quiet and non-fatal: if the refresh fails, start anyway. The
# current token may still be valid, and an expired one produces a better error
# from Claude Code than from a wrapper.
SIGNED_IN=0
/var/jb/usr/bin/python3 -c '
import sys
sys.path.insert(0, "/var/jb/usr/local/lib/claude-native")
import ccauth
ok, err = ccauth.launch_hook()
# Not silent on failure. A refresh that fails leaves a token that will stop
# working, and swallowing the reason is how that turns into "Claude Code says I
# am not signed in, claude-login says I am". Still non-fatal: the current token
# may well have hours left on it.
if err:
    print("claude: could not refresh credentials: %s" % err, file=sys.stderr)
    print("claude: run claude-login if it stops working", file=sys.stderr)
sys.exit(0 if ok else 3)
' && SIGNED_IN=1 || SIGNED_IN=$?

# Fallback for headless use: a long-lived token from `claude setup-token`, which
# skips the credential store entirely. Capped at user:inference by design, so it
# costs Remote Control -- claude-login is the better path. An already-exported
# value always wins.
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ ! -r "$HOME/.claude/ccauth.json" ] \
   && [ ! -r "$HOME/.claude/.credentials.json" ] && [ -r "$HOME/.claude/oauth-token" ]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(tr -d ' \t\r\n' < "$HOME/.claude/oauth-token")"
    [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ] && export CLAUDE_CODE_OAUTH_TOKEN
fi

# Signed out? Claude Code will say "Please run /login", which cannot work here
# (see above). Point at the command that does. Only when there is genuinely no
# credential of any kind -- keychain master (SIGNED_IN), files, or environment --
# so this never nags a working setup.
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -z "$ANTHROPIC_API_KEY" ] \
   && [ -z "$ANTHROPIC_AUTH_TOKEN" ] && [ "$SIGNED_IN" -ne 1 ]; then
    # Claude Code's own item counts as signed in: with bin/security working, a
    # native `claude auth login` puts one there and this module knows nothing
    # about it.
    if ! $LIB/bin/security find-generic-password \
            -a "${USER:-$(id -un)}" -s "Claude Code-credentials" -w >/dev/null 2>&1; then
        if [ "$NATIVE_LOGIN" -eq 1 ]; then
            print -u2 -- "claude: not signed in -- run 'claude auth login' (or claude-login)"
        else
            print -u2 -- "claude: not signed in -- run 'claude-login' (not 'claude auth login')"
        fi
    fi
fi

# The fullscreen renderer takes over the alternate screen and turns on mouse
# tracking, which the terminal apps people use on a phone handle poorly -- and
# Claude Code can switch a session to it on its own, but only while the setting
# has never been written. So write it once, to the value that keeps the normal
# renderer. `/tui fullscreen` still works and is then remembered, since this
# only ever fills in a missing key. grep first: it keeps the common case out of
# python.
SETTINGS=$HOME/.claude/settings.json
if ! grep -q '"tui"' "$SETTINGS" 2>/dev/null; then
    $PREFIX/usr/bin/python3 -c '
import json, os, sys
p = os.path.expanduser("~/.claude/settings.json")
try:
    with open(p) as f:
        s = json.load(f)
    if not isinstance(s, dict) or "tui" in s:
        sys.exit(0)
except FileNotFoundError:
    s = {}
except Exception:
    sys.exit(0)            # malformed or unreadable: never rewrite it
s["tui"] = "default"
os.makedirs(os.path.dirname(p), exist_ok=True)
tmp = p + ".ccios.tmp"
with open(tmp, "w") as f:
    json.dump(s, f, indent=2)
os.replace(tmp, p)
' 2>/dev/null
fi

# Updates come from the repo this package was installed from, so the notice has
# to as well: Claude Code's own updater is off, and it cannot be pointed at an
# APT repo. The check is a cached version string, refreshed in the background at
# most once a day -- a launch never waits on the network, and prints at most one
# line. CCIOS_NO_UPDATE_CHECK=1 turns it off; so does a non-terminal stderr, so
# scripts and the SDK never see it.
CACHE=$HOME/.claude/ccios-repo-version
if [ -z "$CCIOS_NO_UPDATE_CHECK" ] && [ -t 2 ]; then
    installed=$(dpkg-query -W -f='${Version}' com.andi.claude-code-native 2>/dev/null)
    if [ -n "$installed" ]; then
        fresh=( $CACHE(Nm-1) )              # (N) no match is empty, (m-1) newer than a day
        if (( ${#fresh} == 0 )); then
            ( versions=$(curl -fsS --max-time 10 \
                  https://realandi.github.io/CCForiOS/Packages 2>/dev/null \
                | $PREFIX/usr/bin/python3 -c '
import sys
pkg, cur = "com.andi.claude-code-native", None
for line in sys.stdin:
    line = line.rstrip("\n")
    if line.startswith("Package: "):
        cur = line[9:]
    elif line.startswith("Version: ") and cur == pkg:
        print(line[9:])
' 2>/dev/null)
              latest=""
              for v in ${(f)versions}; do
                  if [ -z "$latest" ] || dpkg --compare-versions "$v" gt "$latest"; then latest=$v; fi
              done
              if [ -n "$latest" ]; then
                  mkdir -p ${CACHE:h}
                  print -r -- "$latest" > $CACHE.$$ && mv -f $CACHE.$$ $CACHE
              fi ) >/dev/null 2>&1 &!
        fi
        if [ -r "$CACHE" ]; then
            latest=$(<$CACHE)
            if [ -n "$latest" ] && dpkg --compare-versions "$latest" gt "$installed" 2>/dev/null; then
                print -u2 -- "claude: $latest is available (this is $installed) -- upgrade in Sileo, or:"
                print -u2 -- "  sudo apt update && sudo apt install --only-upgrade com.andi.claude-code-native"
            fi
        fi
    fi
fi

exec $LIB/claude "$@"
