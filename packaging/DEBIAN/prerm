#!/var/jb/usr/bin/zsh
set -e
PREFIX=/var/jb
LIB=$PREFIX/usr/local/lib/claude-native
BIN=$PREFIX/usr/local/bin

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # The binary is fetched at install time, so dpkg does not know about it.
    rm -f "$LIB/claude" "$LIB/claude.previous"
    # Written by the postinst after probing the keychain, so dpkg does not know
    # about it.
    rm -f "$LIB/native-login-ok"
    # Hand `claude` back to whatever owned it before us.
    if [ -L "$BIN/claude" ]; then
        rm -f "$BIN/claude"
        [ -e "$BIN/claude-legacy" ] && mv "$BIN/claude-legacy" "$BIN/claude" || true
    fi
fi

if [ "$1" = "purge" ]; then
    # Purge means purge: the credential's keychain master does not live under
    # $LIB, so dpkg cannot remove it. `remove` keeps it -- an upgrade or a
    # reinstall must stay signed in.
    "$LIB/ccauth-keychain" del >/dev/null 2>&1 || true
fi
exit 0
