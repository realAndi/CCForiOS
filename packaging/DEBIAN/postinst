#!/var/jb/usr/bin/zsh
# Fetch the official Claude Code binary and patch it for iOS.
# The binary is deliberately not shipped in this package; see control.
set -e
[ "$1" = "configure" ] || [ -z "$1" ] || exit 0

PREFIX=/var/jb
LIB=$PREFIX/usr/local/lib/claude-native
BIN=$PREFIX/usr/local/bin
PATH=$PREFIX/usr/bin:$PREFIX/bin:/usr/bin:/bin:$PREFIX/usr/sbin:$PREFIX/sbin
export PATH

. "$LIB/version.env"

say() { print -- "claude-code-native: $*"; }
die() { print -u2 -- "claude-code-native: ERROR: $*"; exit 1; }

# " (exit 132, SIGILL)": a binary the kernel kills prints nothing of its own,
# so the status is the only clue there is.
exit_status() {
    if (( $1 > 128 )); then print -r -- " (exit $1, SIG$signals[$1-127])"
    else print -r -- " (exit $1)"; fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

# Everything below is invoked by name at some point. Sileo installs Depends
# before running this, so a miss here means either a hand-installed .deb or a
# package name that is wrong for this bootstrap -- both worth failing on now,
# with the name, rather than part-way through a 200MB install.
missing=""
for tool in curl tar gzip python3 ldid df mktemp install tr tail cut; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
    || missing="$missing sha256sum"
[ -z "$missing" ] || die "missing required tool(s):$missing
Install them and try again -- on a Procursus bootstrap:
  sudo apt install zsh coreutils curl tar gzip python3 ldid"

# The binary is the official macOS build, compiled for M1-class CPUs. An
# A12-class chip (iPhone XS/XR, iPad Pro 2018/2020, iPad Air 3, iPad mini 5,
# iPad 8th gen) lacks a few of the instructions it uses; the shim emulates
# those, which works but is new. Anything older also lacks ones it uses
# thousands of times over -- atomics, load-acquire, JavaScript's float
# conversion -- and would die of SIGILL before printing a word, so say so now,
# before the download. Only a definite 0 from the kernel counts: iOS 15 has no
# sysctl for some features, and a missing one is not evidence of anything.
cpu=$(python3 - <<'EOF' 2>/dev/null
import ctypes
libc = ctypes.CDLL(None)
def feature(name):
    v = ctypes.c_int(-1)
    n = ctypes.c_size_t(ctypes.sizeof(v))
    ok = libc.sysctlbyname(("hw.optional.arm." + name).encode(),
                           ctypes.byref(v), ctypes.byref(n), None, 0) == 0
    return v.value if ok else -1
model = ctypes.create_string_buffer(64)
n = ctypes.c_size_t(64)
libc.sysctlbyname(b"hw.machine", model, ctypes.byref(n), None, 0)
lacking = [f for f in ("FEAT_LSE", "FEAT_LRCPC", "FEAT_JSCVT") if feature(f) == 0]
tier = "unsupported" if lacking else "a12" if feature("FEAT_LRCPC2") == 0 else "ok"
print(model.value.decode() or "this-device", tier, *lacking)
EOF
) || cpu=""   # a check that cannot run must not stop the install
case "$cpu" in
    *" unsupported"*)
        die "this device (${cpu%% *}) cannot run Claude Code: its CPU lacks${cpu#* unsupported}.
Claude Code needs an A12 chip or newer: iPhone XS/XR or later; on iPad, the
2018 iPad Pro, iPad Air 3, iPad mini 5, iPad 8th generation, or later." ;;
    *" a12")
        say "NOTE: ${cpu%% *} has an A12-class CPU. Claude Code runs on it by emulating"
        say "  a few newer CPU instructions. Support is experimental -- some errors"
        say "  can occur. Please report them." ;;
esac

# ~200MB binary + the download + the patched copy; ask for headroom.
# Field 4 of df's POSIX output is the free space in KB. Split it out in zsh, not
# awk: awk is only a virtual package on Procursus (gawk or mawk), not in every
# bootstrap, and this was its one use -- an iPad without it refused to install.
df_fields=( $(df -Pk "$LIB" | tail -1) )
avail=$df_fields[4]
[ "${avail:-0}" -gt 700000 ] || die "need ~700MB free under $LIB, have $((avail/1024))MB"

# Stage inside $LIB, not /tmp: the sandbox refuses to mmap() a dylib out of
# /var/tmp, so the pre-install smoke test could not load libshim.dylib there.
# Same filesystem also makes the final move atomic.
WORK=$(mktemp -d "$LIB/.build.XXXXXX")
trap 'rm -rf "$WORK"' EXIT INT TERM

# Two independent sources for the same artifact. npm first only because its
# tarball is ~87MB against ~199MB for the raw binary; either way the bytes we
# end up with must hash to Anthropic's published checksum.
fetch_from_npm() {
    say "trying npm registry (~87MB compressed)"
    curl -fsSL --retry 3 --retry-delay 2 "$CC_URL_NPM" -o "$WORK/pkg.tgz" || return 1
    got=$(sha256_of "$WORK/pkg.tgz")
    [ "$got" = "$CC_TARBALL_SHA256" ] || { say "  tarball checksum mismatch"; return 1; }
    tar xzf "$WORK/pkg.tgz" -C "$WORK" package/claude || return 1
    mv "$WORK/package/claude" "$WORK/claude.orig"
    return 0
}

fetch_from_cdn() {
    say "trying Anthropic release CDN (~199MB)"
    curl -fsSL --retry 3 --retry-delay 2 "$CC_URL_CDN" -o "$WORK/claude.orig" || return 1
    return 0
}

fetch_from_npm || fetch_from_cdn || die "could not download Claude Code $CC_VERSION from either source
  npm: $CC_URL_NPM
  cdn: $CC_URL_CDN"

got=$(sha256_of "$WORK/claude.orig")
[ "$got" = "$CC_BINARY_SHA256" ] || die "binary checksum mismatch
  expected $CC_BINARY_SHA256
  got      $got
Refusing to patch a binary that is not the one this package was built against."
say "got Claude Code $CC_VERSION, checksum verified"

say "patching for iOS"
# ccios_patch.py refuses if upstream added a dylib we have not vetted or dropped
# a symbol the shim provides, rather than producing a broken binary.
python3 "$LIB/ccios_patch.py" "$WORK/claude.orig" "$WORK/claude.ios" \
    || die "patching failed -- upstream build changed shape; not installing"
rm -f "$WORK/claude.orig" "$WORK/pkg.tgz"

ldid "-S$LIB/entitlements.plist" "$WORK/claude.ios" || die "ldid signing failed"

# iOS refuses to load unsigned code ("mapped file has no cdhash"), so make sure
# the INSTALLED shim is signed before anything else -- signing only the staged
# copy would let the smoke test pass on a layout that is not what ends up on
# disk. Sign in place first, then stage from it, so the test is faithful.
ldid -S "$LIB/libshim.dylib" 2>/dev/null || true
# The keychain helper needs the same entitlements: its keychain-access-groups
# entry is what authorizes SecItem access, and without it SecItemAdd fails with
# -34018 (measured on device). Sign the installed copy, same reasoning as above.
ldid -S"$LIB/entitlements.plist" "$LIB/ccauth-keychain" 2>/dev/null || true
cp "$LIB/libshim.dylib" "$WORK/libshim.dylib"
chmod 755 "$WORK/claude.ios"
say "verifying"
out=$(cd "$WORK" && DISABLE_AUTOUPDATER=1 BUN_JSC_useConcurrentJIT=0 \
      ./claude.ios --version 2>&1) || { rc=$?; die "patched binary did not run$(exit_status $rc): $out"; }
case "$out" in
    *"$CC_VERSION"*) say "verified: $out" ;;
    *) die "unexpected --version output: $out" ;;
esac

# No rollback copy is kept: the binary is verified above *before* the installed
# one is touched, and a reinstall can always re-fetch it. Saves ~200MB.
mv -f "$WORK/claude.ios" "$LIB/claude"

# Take over `claude`, keeping whatever was there as a rollback.
if [ -e "$BIN/claude" ] && [ ! -L "$BIN/claude" ] && [ ! -e "$BIN/claude-legacy" ]; then
    cp -p "$BIN/claude" "$BIN/claude-legacy"
    say "previous claude wrapper saved as claude-legacy"
fi
ln -sfn "$BIN/claude-native" "$BIN/claude"

# Final check against the real installed layout, not the staging directory.
# Cheap, and it is the only thing that proves what the user will actually run.
out=$(cd "$LIB" && DISABLE_AUTOUPDATER=1 BUN_JSC_useConcurrentJIT=0 \
      ./claude --version 2>&1) || { rc=$?; die "installed binary does not run$(exit_status $rc): $out"; }

# Say something honest about this device's keychain while we are here. Advisory:
# a broken keychain does not make the package unusable (CCAUTH_PLAINTEXT=1 keeps
# the credential in a 0600 file), but the user should hear it now, not at
# sign-in.
if out=$("$LIB/ccauth-keychain" probe 2>&1) && [ "$out" = "probe: ok" ]; then
    say "keychain accessible -- the credential will be stored there"
else
    say "WARNING: keychain probe failed: $out"
    say "  sign-in still works with CCAUTH_PLAINTEXT=1 (0600 file)"
fi

# $HOME here is root's -- the postinst runs under sudo -- so look where a
# credential actually lives: the keychain master first (the helper exits 0 with
# the blob, 3 when nothing is stored), then the files under the device user's
# home.
USERHOME=/var/jb/var/mobile
if "$LIB/ccauth-keychain" get >/dev/null 2>&1 \
   || [ -r "$USERHOME/.claude/ccauth.json" ] || [ -r "$USERHOME/.claude/.credentials.json" ] \
   || [ -r "$USERHOME/.claude/oauth-token" ]; then
    say "installed $CC_VERSION -- run: claude"
else
    say "installed $CC_VERSION"
    say "Sign in first:  claude-login"
    say "  (not 'claude auth login' -- that cannot save credentials on iOS)"
fi
exit 0
