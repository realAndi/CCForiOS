#!/var/jb/usr/bin/python3
"""claude-login — sign in to Claude Code on iOS.

Runs the OAuth flow itself, with the same scopes `claude auth login` requests,
and writes ~/.claude/.credentials.json. Claude Code reads that file happily; it
just cannot write it on iOS, which is why its own login appears to work and then
leaves you signed out. See ccauth.py for the details.

Full scope matters: user:profile is the difference between Remote Control
working and not, and a `claude setup-token` token is capped at user:inference.

  claude-login            sign in, always -- even if a credential is stored
  claude-login --status   show what is stored, and when it expires
  claude-login --refresh  renew the access token without a browser
  claude-login --logout   delete the stored credential
"""

import os
import sys
import time

sys.path.insert(0, "/var/jb/usr/local/lib/claude-native")
import ccauth  # noqa: E402


def say(m):
    print("\033[36m==>\033[0m %s" % m)


def warn(m):
    print("\033[33m!\033[0m %s" % m, file=sys.stderr)


def fmt_age(ms):
    if not ms:
        return "unknown"
    delta = ms / 1000 - time.time()
    if delta < 0:
        return "expired"
    if delta < 3600:
        return "%d min" % (delta / 60)
    if delta < 86400:
        return "%.1f hours" % (delta / 3600)
    return "%.1f days" % (delta / 86400)


def status():
    creds = ccauth.read()
    if not creds:
        print("Not signed in. Run: claude-login")
        return 1
    o = creds.get("claudeAiOauth", {})
    meta = creds.get("ccauth") or {}
    print("Signed in.")
    if meta.get("email"):
        print("  account:        %s" % meta["email"])
    if meta.get("organization"):
        print("  organization:   %s" % meta["organization"])
    # Only shown when the server actually told us; it is absent from a refresh
    # response, and printing "unknown" just looks like something is wrong.
    if o.get("subscriptionType"):
        print("  plan:           %s" % o["subscriptionType"])
    print("  scopes:         %s" % (" ".join(o.get("scopes", [])) or "none"))
    print("  access token:   expires in %s" % fmt_age(o.get("expiresAt")))
    print("  refresh token:  expires in %s" % fmt_age(o.get("refreshTokenExpiresAt")))
    if "user:profile" not in o.get("scopes", []):
        warn("missing user:profile — Remote Control will not work")
    return 0


def logout():
    removed = False
    for p in (ccauth.STORE, ccauth.CRED,
              os.path.join(ccauth.HOME, ".claude", "oauth-token")):
        try:
            os.remove(p)
            print("  removed %s" % p)
            removed = True
        except OSError:
            pass
    print("Signed out." if removed else "Was not signed in.")
    return 0


def refresh():
    changed, err = ccauth.refresh_if_needed(force=True)
    if err:
        warn(err)
        return 1
    say("Refreshed." if changed else "Nothing to refresh (no credential stored).")
    return 0


def login():
    if not sys.stdin.isatty():
        warn("claude-login needs a terminal (run it in NewTerm).")
        return 1

    url, verifier, state = ccauth.authorize_url()
    print()
    say("Open this in Safari and approve:")
    print()
    print("  %s" % url)
    print()
    print("  Then copy the code it gives you and paste it below.")
    print()
    try:
        code = input("  code: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        warn("Cancelled.")
        return 1
    if not code:
        warn("No code given.")
        return 1

    try:
        scopes = ccauth.exchange(code, verifier, state)
    except ccauth.AuthError as e:
        warn(str(e))
        return 1

    print()
    say("Signed in. Scopes: %s" % " ".join(scopes))
    if "user:profile" in scopes:
        say("Remote Control is available.")
    say("Run: claude")
    return 0


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("--status", "status"):
        return status()
    if arg in ("--logout", "logout"):
        return logout()
    if arg in ("--refresh", "refresh"):
        return refresh()
    if arg in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    # No already-signed-in short circuit. The case that matters is a credential
    # that exists but no longer works -- a refresh that failed while offline, a
    # token revoked from the web -- and refusing to act on the word "login"
    # because a file is present is exactly wrong there: Claude Code says it is
    # not signed in, this said it was, and there was nothing to do about it.
    # Signing in again when you did not need to costs one browser round trip.
    return login()


if __name__ == "__main__":
    sys.exit(main())
