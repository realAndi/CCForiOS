# Written by tools/build-deb.sh; read by the postinst.
# CC_BINARY_SHA256 is Anthropic's own published checksum, taken from
# downloads.claude.ai/.../manifest.json at build time and confirmed to match the
# binary inside the npm tarball. Whichever source the postinst ends up using,
# the bytes it installs must hash to this.
CC_VERSION=@CC_VERSION@
CC_BINARY_SHA256=@CC_BINARY_SHA256@
CC_TARBALL_SHA256=@CC_TARBALL_SHA256@
CC_URL_NPM=https://registry.npmjs.org/@anthropic-ai/claude-code-darwin-arm64/-/claude-code-darwin-arm64-@CC_VERSION@.tgz
CC_URL_CDN=https://downloads.claude.ai/claude-code-releases/@CC_VERSION@/darwin-arm64/claude
