#!/var/jb/usr/bin/zsh
# Claude Code, native darwin-arm64 build patched to run on iOS.
# See ~/ccnative/LOG.md on the build host for how the binary was made.

export HOME="${HOME:-/var/jb/var/mobile}"

# No iOS build exists upstream, so never let it replace itself.
export DISABLE_AUTOUPDATER=1

# REQUIRED. JSC's JIT pool is flipped between RW and RX with mprotect (iOS has
# no MAP_JIT and refuses to execute a writable page). That flip is process-wide
# where the real pthread_jit_write_protect_np is per-thread, so a background
# compiler thread would flip the pool to RW while the main thread is executing
# out of it -> "panic: Bus error". Compiling on the mutator thread avoids it.
export BUN_JSC_useConcurrentJIT=0

# Credentials.
#
# Claude Code stores credentials through Bun.secrets, which cannot write on iOS,
# so `claude auth login` signs in and then silently discards the result. It
# reads ~/.claude/.credentials.json perfectly well though, so claude-login does
# the OAuth flow itself and writes that file, and this refreshes the access
# token before it expires. Without the refresh the credential dies after ~8
# hours, which is exactly how the copied-from-desktop setup used to fail.
#
# Deliberately quiet and non-fatal: if the refresh fails, start anyway. The
# current token may still be valid, and an expired one produces a better error
# from Claude Code than from a wrapper.
if [ -r "$HOME/.claude/.credentials.json" ] && [ -r /var/jb/usr/local/lib/claude-native/ccauth.py ]; then
    /var/jb/usr/bin/python3 -c 'import sys; sys.path.insert(0, "/var/jb/usr/local/lib/claude-native"); import ccauth; ccauth.refresh_if_needed()' 2>/dev/null || true
fi

# Fallback for headless use: a long-lived token from `claude setup-token`, which
# skips the credential store entirely. Capped at user:inference by design, so it
# costs Remote Control -- claude-login is the better path. An already-exported
# value always wins.
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ ! -r "$HOME/.claude/.credentials.json" ] \
   && [ -r "$HOME/.claude/oauth-token" ]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(tr -d ' \t\r\n' < "$HOME/.claude/oauth-token")"
    [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ] && export CLAUDE_CODE_OAUTH_TOKEN
fi

exec /var/jb/usr/local/lib/claude-native/claude "$@"
