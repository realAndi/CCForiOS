<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.private.cs.debugger</key>
    <true/>
    <key>dynamic-codesigning</key>
    <true/>
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <!-- Deliberately NOT com.apple.developer.cs.allow-jit: it is Apple's real
         provisioning-tied JIT entitlement, and on at least one AMFI patch level
         (measured on a research-kernel device) claiming it on an ad-hoc signed
         binary gets the process killed outright, silently, on the very first
         exec -- before any output. It is also unnecessary: the shim never uses
         iOS's real MAP_JIT/pthread_jit_write_protect_np path, only mprotect, so
         this entitlement was never doing anything functional in the first
         place. com.apple.security.cs.allow-jit (the macOS hardened-runtime key,
         meaningless on iOS) is harmless and stays. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Credential storage. Claude Code dlopen()s Security.framework and stores
         credentials with SecItemAdd/kSecClassGenericPassword. On iOS that call
         returns -34018 (errSecMissingEntitlement) without a keychain group, so
         `claude auth login` completed and then silently failed to persist,
         leaving the next run logged out. With these two the item is written and
         read back cleanly (verified on device). The group is named after this
         package, so it is scoped to it and shared with nothing else. -->
    <key>application-identifier</key>
    <string>com.andi.claude-code-native</string>
    <key>keychain-access-groups</key>
    <array>
        <string>com.andi.claude-code-native</string>
    </array>
</dict>
</plist>
